#!/usr/bin/env bash
# Resolve the ignored SDD artifact workspace for one plan.
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
root=$(cd "$root" && pwd -P)
plan_dir=$(cd "$(dirname "$plan")" && pwd -P)
plan_name=$(basename "$plan")
canonical_plan="$plan_dir/$plan_name"
case "$canonical_plan" in
  "$root"/*) relative_plan=${canonical_plan#"$root"/} ;;
  *) echo "plan is outside the repository: $plan" >&2; exit 2 ;;
esac

readable=$(basename "$plan_name" .md)
readable=$(printf '%s' "$readable" | LC_ALL=C tr -cs 'A-Za-z0-9._-' '-')
readable=${readable#.}
readable=${readable#-}
[ -n "$readable" ] && [ "$readable" != "." ] && [ "$readable" != ".." ] || {
  echo "cannot derive a workspace name from: $plan" >&2
  exit 2
}

path_hash=$(printf '%s' "$relative_plan" | git -C "$root" hash-object --stdin | cut -c1-12)
base="$root/.superpowers/sdd"
dir="$base/$readable-$path_hash"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd -P
